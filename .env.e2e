# Valores fixos só pra rodar a stack de E2E (efêmera, nunca em produção) —
# seguro versionar, não são segredos reais.
POSTGRES_PASSWORD=e2e-test-password
NEXTAUTH_SECRET=e2e-test-secret-not-for-production

# Portas diferentes das que a stack de dev local usa (5432/8420), pra
# poder rodar as duas ao mesmo tempo sem conflito.
DB_HOST_PORT=5433
APP_HOST_PORT=3010
